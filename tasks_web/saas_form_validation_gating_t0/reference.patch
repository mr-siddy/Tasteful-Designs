 const EMPTY: FormValues = { name: '', email: '', crew: '', notes: '' }
 
+const EMAIL_SHAPE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/
+
 const WHAT_HAPPENS = [
   'A solutions engineer calls you back within one business day — not a sales development rep reading a script.',
